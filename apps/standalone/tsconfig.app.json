{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "rootDir": "src",
    "outDir": "out-tsc/app",
    "tsBuildInfoFile": "out-tsc/app.tsbuildinfo"
  },
  "include": ["src/*.ts", "src/services/capacitor_*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/sw.ts",
    "src/local-server-worker.ts",
    "src/test_setup.ts",
    "src/test_environment_worker.ts"
  ],
  "references": [
    { "path": "../client/tsconfig.app.json" },
    { "path": "../../packages/commons/tsconfig.lib.json" }
  ]
}
