[Desktop Entry]
Name=Trilium Notes
Comment=Grow your knowledge base
Keywords=notes;note-taking;knowledge base;wiki;outliner;markdown;journal;Trillium;
Exec=trilium %U
Icon=org.triliumnotes.Trilium
Type=Application
StartupNotify=true
StartupWMClass=trilium
Categories=Office;Utility;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=trilium --new-window
