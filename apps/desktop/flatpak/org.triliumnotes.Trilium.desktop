[Desktop Entry]
Name=Trilium Notes
Comment=Build your personal knowledge base with Trilium Notes
Keywords=Trillium;
Exec=trilium %U
Icon=org.triliumnotes.Trilium
Type=Application
StartupNotify=true
StartupWMClass=trilium
Categories=Office;Utility;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=trilium --new-window
