            <table class="MsoNormalTable">
             <tr>
              <td>
              <p class="MsoNormal" style="text-align:justify"><span><img width="660" src="https://mcusercontent.com/d65d3565f9cb81130e9bfb0ca/images/4392525f-1ce8-b015-85b7-b012aa03e2bb.jpg" style="width:660px" data-block-id="4" class="imageDropZone mceImage" /></span><span></span></p></td></tr></table></td></tr></table></td></tr></table></div></span><p></p>
