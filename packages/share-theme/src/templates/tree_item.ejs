<ul>
    <% for (const item of items) { %>
        <li class="<%= item.children.length ? "submenu-item" : "item" %><%= item.isExpanded ? " expanded" : "" %>" data-note-id="<%= item.noteId %>">
            <div class="tree-item-row<%= item.isActive ? " active" : "" %>">
                <% if (item.children.length) { %><button type="button" class="collapse-button" aria-expanded="<%= item.isExpanded %>" aria-label="<%= t("share_theme.subpages-of", { title: item.title }) %>"><span class="tn-icon bx bx-chevron-down" aria-hidden="true"></span></button><% } %>
                <a class="type-<%= item.type %> no-arrow<%= item.isActive ? " active" : "" %>" href="<%= item.href %>"<% if (item.isExternal) { %> target="_blank" rel="noopener noreferrer"<% } %>>
                    <span class="tn-icon <%= item.icon %>" aria-hidden="true"></span><span class="tree-item-title"><%= item.title %></span>
                </a>
                <% if (item.hiddenChildCount) { %><span class="tree-item-hidden-count" title="<%= t("share_theme.hidden-subpages", { count: item.hiddenChildCount }) %>"><%= item.hiddenChildCount %></span><% } %>
            </div>
            <% if (item.isActive && headings.length > 1) { %>
                <nav class="tree-toc" aria-label="<%= t("share_theme.on-this-page") %>">
                    <%- include("tree_toc", { entries: toc }) %>
                </nav>
            <% } %>
            <% if (item.children.length) { %>
                <%- include("tree_item", { items: item.children }) %>
            <% } %>
        </li>
    <% } %>
</ul>
