<script>
    // Applies the theme before the first paint, to avoid color flashes. The
    // function keeps its names out of the global scope, which `~shareHtml` snippets share.
    (function () {
        function read(key) {
            try {
                return localStorage.getItem(key);
            } catch {
                return null;
            }
        }

        const root = document.documentElement;
        const prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = read("theme") || (prefersDark ? "dark" : "light");
        root.classList.add(`theme-${theme}`);

        window.glob = {
            isStatic: <%= !!isStatic %>,
            theme
        };
    })();
</script>
