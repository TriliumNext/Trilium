{
  "name": "@triliumnext/share-theme",
  "version": "1.0.3",
  "description": "Default theme for shared notes and static HTML exports",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/build.ts --watch",
    "build": "tsx scripts/build.ts",
    "dist": "tsx scripts/build.ts --minify",
    "test": "vitest run"
  },
  "exports": {
    "./templates/*": "./src/templates/*",
    "./*": "./dist/*"
  },
  "author": "Elian Doran <contact@eliandoran.me>",
  "contributors": [
    "Zerebos <me@zerebos.com>"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@triliumnext/commons": "workspace:*",
    "fuse.js": "7.5.0",
    "katex": "0.19.0"
  },
  "devDependencies": {
    "@triliumnext/ckeditor5": "workspace:*",
    "@triliumnext/highlightjs": "workspace:*",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "sass": "1.105.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
