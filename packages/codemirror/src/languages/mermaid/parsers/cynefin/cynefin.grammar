// Follows the Langium grammar of Mermaid's Cynefin diagram (`@mermaid-js/parser`).
@top CynefinDiagram { DiagramName ":"? statement* }

statement { Title | Domain | Transition }

Title { kw<"title"> TitleText? }

Domain { DomainName Item* }

Item { String }

Transition { DomainName "-->" DomainName (":" String)? }

DomainName {
  @specialize<identifier, "complex"> | @specialize<identifier, "complicated"> |
  @specialize<identifier, "clear"> | @specialize<identifier, "chaotic"> |
  @specialize<identifier, "confusion">
}

DiagramName { @specialize<identifier, "cynefin-beta"> }

kw<term> { @specialize[@name=Keyword]<identifier, term> }

@skip { space | LineComment }

@external tokens titleText from "./tokens.js" { TitleText }

@tokens {
  space { $[ \t\r\n]+ }
  identifier { @asciiLetter ($[a-zA-Z0-9_\-]* $[a-zA-Z0-9_])? }
  String { '"' (!["\\\n] | "\\" _)* '"' | "'" (!['\\\n] | "\\" _)* "'" }
  LineComment { "%%" ![\n]* }
  "-->" ":"
}

@external propSource cynefinHighlighting from "./highlight.js"
